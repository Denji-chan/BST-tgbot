# Bu fayldan nusxa olib, .env deb nomlang va qiymatlarni to'ldiring.
# .env hech qachon git'ga yoki boshqa joyga yuborilmaydi.

# --- Majburiy ---

# @BotFather bergan token
BOT_TOKEN=9252053364:AAFO5x8wA9KScvwhLWQa1xlMAplN7eDoAd8

# Bosh admin (Developer) Telegram ID raqami. Boshqa adminlar bazada saqlanadi.
DEVELOPER_ID=8897276236

# PostgreSQL ulanishi (asyncpg drayveri bilan).
# Docker'da host "db" bo'ladi: postgresql+asyncpg://bestshop:PAROL@db:5432/bestshop
DATABASE_URL=postgresql+asyncpg://bestshop:AD1905883@localhost:5432/bestshop

# docker-compose'dagi PostgreSQL konteyneri uchun (DATABASE_URL bilan bir xil bo'lsin)
POSTGRES_USER=bestshop
POSTGRES_PASSWORD=AD1905883
POSTGRES_DB=bestshop

# --- Ixtiyoriy (standart qiymatlar ko'rsatilgan) ---

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Xarid summasining necha foizigacha cashback bilan to'lash mumkin (0-100)
CASHBACK_MAX_USE_PERCENT=100

# Loglar darajasi: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log fayllari papkasi
LOG_DIR=logs